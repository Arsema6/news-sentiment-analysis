 "cells": [
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "# News Sentiment Analysis — Exploratory Data Analysis (EDA)\n",
    "\n",
    "This notebook covers: Descriptive statistics, topic modeling, time-series analysis, and publisher analysis of news headlines."
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "import pandas as pd\n",
    "import numpy as np\n",
    "import matplotlib.pyplot as plt\n",
    "import seaborn as sns\n",
    "from sklearn.feature_extraction.text import CountVectorizer, TfidfVectorizer\n",
    "from wordcloud import WordCloud\n",
    "from sklearn.decomposition import LatentDirichletAllocation\n",
    "from datetime import datetime\n",
    "# import nltk  # Uncomment if using advanced NLP\n",
    "\n",
    "# Load data (UPDATE path as needed)\n",
    "df = pd.read_csv(\"data/your_data.csv\")  # Replace with actual CSV path\n",
    "df['publish_date'] = pd.to_datetime(df['publish_date'])"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 1. Descriptive Statistics"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Headline Length Distribution\n",
    "df['headline_length'] = df['headline'].str.len()\n",
    "plt.figure(figsize=(8, 4))\n",
    "sns.histplot(df['headline_length'], bins=30, kde=True)\n",
    "plt.title('Headline Length Distribution')\n",
    "plt.xlabel('Number of Characters')\n",
    "plt.ylabel('Frequency')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Articles per Publisher\n",
    "plt.figure(figsize=(10, 6))\n",
    "top_publishers = df['publisher'].value_counts().head(10)\n",
    "sns.barplot(x=top_publishers.values, y=top_publishers.index)\n",
    "plt.title('Top 10 Most Active Publishers')\n",
    "plt.xlabel('Number of Articles')\n",
    "plt.ylabel('Publisher')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Publication Dates Over Time\n",
    "df_by_day = df.groupby(df['publish_date'].dt.date).size()\n",
    "df_by_day.plot(figsize=(12,5))\n",
    "plt.title('Articles Published Over Time')\n",
    "plt.xlabel('Date')\n",
    "plt.ylabel('Number of Articles')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 2. Text Analysis (Keyword & Topic Modeling)"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# TF-IDF Keywords\n",
    "tfidf = TfidfVectorizer(stop_words='english', max_features=30)\n",
    "tfidf_matrix = tfidf.fit_transform(df['headline'].fillna(''))\n",
    "keywords = tfidf.get_feature_names_out()\n",
    "scores = np.asarray(tfidf_matrix.sum(axis=0)).ravel()\n",
    "top_keywords = pd.Series(scores, index=keywords).sort_values(ascending=False)\n",
    "top_keywords.plot(kind='bar', figsize=(12, 5), title='Top Keywords by TF-IDF')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Topic Modeling with LDA\n",
    "vectorizer = CountVectorizer(stop_words='english', max_features=1000)\n",
    "X = vectorizer.fit_transform(df['headline'].fillna(''))\n",
    "lda = LatentDirichletAllocation(n_components=5, random_state=42)\n",
    "lda.fit(X)\n",
    "\n",
    "def print_topics(model, feature_names, n_top_words=8):\n",
    "    for idx, topic in enumerate(model.components_):\n",
    "        print(f\"Topic {idx + 1}: ", \" \\ ".join([feature_names[i] for i in topic.argsort()[:-n_top_words-1:-1]]))\n",
    "\n",
    "print_topics(lda, vectorizer.get_feature_names_out())"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 3. Time Series Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "# Articles Per Hour\n",
    "df['hour'] = df['publish_date'].dt.hour\n",
    "sns.histplot(df['hour'], bins=24)\n",
    "plt.title('Publication Time of Day')\n",
    "plt.xlabel('Hour')\n",
    "plt.ylabel('Number of Articles')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 4. Publisher Domain Analysis"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "df['publisher_domain'] = df['publisher'].str.extract(r'@([\\w\\.-]+)')\n",
    "domain_counts = df['publisher_domain'].value_counts().head(10)\n",
    "domain_counts.plot(kind='barh', title='Top Publisher Domains')\n",
    "plt.xlabel('Number of Articles')\n",
    "plt.show()"
   ]
  },
  {
   "cell_type": "markdown",
   "metadata": {},
   "source": [
    "## 5. Word Cloud"
   ]
  },
  {
   "cell_type": "code",
   "execution_count": null,
   "metadata": {},
   "outputs": [],
   "source": [
    "text = ' '.join(df['headline'].dropna())\n",
    "wc = WordCloud(width=800, height=400, background_color='white').generate(text)\n",
    "plt.figure(figsize=(15, 7))\n",
    "plt.imshow(wc, interpolation='bilinear')\n",
    "plt.axis('off')\n",
    "plt.title('Word Cloud of Headlines', size=18)\n",
    "plt.show()"
   ]
  }
 ],
